{
  "feature_columns": [
    "cycle_order",
    "voltage_mean_V",
    "voltage_std_V",
    "voltage_min_V",
    "voltage_max_V",
    "voltage_median_V",
    "voltage_q10_V",
    "voltage_q90_V",
    "current_abs_mean_A",
    "current_abs_std_A",
    "current_abs_median_A",
    "temperature_mean_C",
    "temperature_std_C",
    "temperature_min_C",
    "temperature_max_C"
  ],
  "categorical_columns": [
    "source_dataset",
    "battery_family"
  ],
  "target_column": "soh_pct",
  "group_column": "entity_id",
  "soh_definition": "100 * discharge_capacity_Ah / published_nominal_capacity_Ah",
  "nominal_capacity_Ah": {
    "NASA": 2.0,
    "CALCE_CS2": 1.1,
    "CALCE_CX2": 1.35
  }
}