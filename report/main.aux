\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end architecture of WD-GPR-SR. Dual-branch Wide-and-Deep feature extractors feed a Sparse Variational Gaussian Process ($M=64$ inducing points), generating calibrated posterior distributions. Leak-free inner cross-fitting extracts out-of-fold residuals, weighted by heteroscedastic precision scores to steer genetic symbolic regression. Calibrated shrinkage guardrails fuse predictions for edge BMS deployment.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:architecture}{{1}{5}{End-to-end architecture of WD-GPR-SR. Dual-branch Wide-and-Deep feature extractors feed a Sparse Variational Gaussian Process ($M=64$ inducing points), generating calibrated posterior distributions. Leak-free inner cross-fitting extracts out-of-fold residuals, weighted by heteroscedastic precision scores to steer genetic symbolic regression. Calibrated shrinkage guardrails fuse predictions for edge BMS deployment}{figure.caption.3}{}}
